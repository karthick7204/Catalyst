# ==============================================================================
# Catalyst Sprint 1 - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3001

# Linear Webhook Configuration
# Obtain from Linear Team Settings -> API -> Webhooks -> Signing Secret
LINEAR_WEBHOOK_SECRET=lin_wh_sec_your_linear_signing_secret_here

# Label triggering automated bug-fixing pipeline (default: ai-fix)
TRIGGER_LABEL=ai-fix

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional Redis URL (overrides REDIS_HOST/PORT if set):
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# GitHub Authentication
# GitHub Fine-Grained Personal Access Token or Classic PAT with 'repo' scope
# Used securely inside ephemeral container memory; never persisted to disk.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Fallback GitHub repository URL (if missing from issue description or custom field)
DEFAULT_GITHUB_REPO_URL=https://github.com/your-org/your-repo.git

# Ephemeral Sandbox Scratch Directory (Host path mounted into /workspace for MCP agents)
SCRATCH_DIR=/tmp/catalyst-workspaces

# Docker Engine Configuration
DOCKER_SANDBOX_IMAGE=alpine/git:latest
# Unix Socket (macOS / Linux default):
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Windows Docker Engine Named Pipe:
# DOCKER_SOCKET_PATH=//./pipe/docker_engine
# Remote Docker Daemon over TCP (Optional):
# DOCKER_HOST=127.0.0.1
# DOCKER_PORT=2375
