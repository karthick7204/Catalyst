# Catalyst Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Linear Integration
# Linear Webhook secret configured in your Linear Team settings
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret_here
# Linear Personal API key or OAuth token for commenting and updating tickets
LINEAR_API_KEY=lin_api_your_linear_api_key_here

# GitHub App Integration (Production scoped credentials)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID=
# Optional fallback Personal Access Token for testing without GitHub App:
GITHUB_TOKEN=ghp_your_github_token_here

# AI / LLM Configuration
# Choose provider: gemini | anthropic | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-3.1-flash-lite

# Queue & Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catalyst?schema=public"

# Sandbox Configuration
# Storage location for ephemeral clone workspaces
SANDBOX_WORKSPACES_ROOT=/tmp/catalyst-workspaces
# Timeout in milliseconds for agent execution (default 10 minutes)
AGENT_EXECUTION_TIMEOUT_MS=600000
